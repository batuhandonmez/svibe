# Supabase PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090,http://127.0.0.1:8090,http://localhost:8093,http://127.0.0.1:8093,http://localhost:8095,http://127.0.0.1:8095,http://localhost:8096,http://127.0.0.1:8096

# AWS S3 audio storage
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=svibe-audio-dev
AWS_S3_AUDIO_PREFIX=vibes
MAX_AUDIO_FILE_SIZE_MB=20

# Product defaults
DEFAULT_DAILY_VIBE_COUNT=3
VIP_DAILY_VIBE_COUNT=30
LUCKY_UNMUTED_PERCENT=10

# Auth
JWT_SECRET_KEY=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Basic in-process API abuse protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_PER_WINDOW=30
WRITE_RATE_LIMIT_PER_WINDOW=120
